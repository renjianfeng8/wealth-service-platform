### VS Code ###
.vscode/

# Frontend build artifacts
front/dist/
front/node_modules/

# Self-signed SSL certificates & PKCS12 keystores (regenerate via deploy/ssl/gen-cert.ps1)
deploy/ssl/*
!deploy/ssl/gen-cert.ps1
**/resources/ssl/*.pfx

# MySQL backup files (generated by backup scripts)
backups/*.sql.gz

# Root-level runtime log files (generated by each service)
*.log

# Runtime logs (generated by each service via logback-spring.xml)
logs/

# Startup logs
*.startup.log

# Local scripts (developer-specific)
start_claude.bat

# Test output
test-results/

# Vite cache
.vite/
front/vite-dev.pid
front/start-vite-dev.bat

# Environment variables (contains credentials)
.env
.env.prod
.env.local

# Local helper scripts — 仅跟踪无敏感信息的运维脚本，部署脚本(含服务器IP/密钥路径)保持忽略
scripts/**
!scripts/dev/
!scripts/db/
!scripts/dev/start-local.ps1
!scripts/dev/stop-local.ps1
!scripts/db/backup-mysql.sh
!scripts/db/backup-scheduler.sh
!scripts/db/restore-mysql.sh

# Compiled Java classes (standalone, not build output)
*.class

# Compressed archives
*.tar.gz

# Python scripts in project root
/*.py

# Claude Code - local settings (per-developer)
.claude/worktrees/
.claude/settings.local.json

# Superpowers brainstorm 可视化工具运行时状态
.superpowers/

# Runtime process id files (never commit)
*.pid

# Personal files
JIANLI.md

# Old UI prototype
UI.html

