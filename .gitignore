### VS Code ###
.vscode/

# Frontend build artifacts
front/dist/
front/node_modules/
front-user/dist/
front-user/node_modules/
front-user/playwright-report/
front-user/test-results/

# Self-signed SSL certificates & PKCS12 keystores (regenerate via ssl/gen-cert.ps1)
ssl/
**/resources/ssl/*.pfx

# MySQL backup files (generated by backup scripts)
backups/*.sql.gz
backups/*.log

# Root-level runtime log files (generated by each service)
*.log

# Runtime logs (generated by each service via logback-spring.xml)
logs/

# Startup logs
*.startup.log
gateway.log
system.log

# Local scripts (developer-specific)
start_claude.bat

# Test output
test-results/

# E2E test artifacts
api-e2e/node_modules/
api-e2e/test-results/
api-e2e/playwright-report/
api-e2e-report/

# Vite cache
.vite/

# Seata server config (not project source code)
seata-config/

# Environment variables (contains credentials)
.env
.env.prod
.env.local

# Local helper scripts (devops/deployment utilities)
scripts/

# Compiled Java classes (standalone, not build output)
*.class

# Compressed archives
*.tar.gz

# Python scripts in project root
/*.py
.claude/worktrees/
