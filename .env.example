# ============================================================
# 理财服务平台 - 环境变量模板
# 复制为 .env 并填入实际密码后再启动 docker-compose
#
#   cp .env.example .env
#
# 安全要求：所有密码必须至少 8 位，包含大小写字母和数字
# ============================================================

# ---- Nacos ----
# 本地开发: echo -n "DevNacosSecretKeyForWealthPlatform2026" | base64
# 生产环境: echo -n "WealthPlatform@infra-secret-key-2026" | base64
# 要求: Base64 解码后长度 >= 32 字符
NACOS_AUTH_TOKEN=your-nacos-auth-token-base64-encoded-min-32-chars
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-nacos-password

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# ---- Elasticsearch ----
ES_SECURITY_ENABLED=true
ES_USERNAME=elastic
ES_PASSWORD=your-es-password

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=your-rabbitmq-user
RABBITMQ_DEFAULT_PASS=your-rabbitmq-password

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# ---- Seata ----
SEATA_SECRET_KEY=your-seata-secret-key-at-least-32-chars-long
