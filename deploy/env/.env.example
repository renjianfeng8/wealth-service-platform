# ============================================================
# 理财服务平台 - 环境变量模板
# 复制为 .env 并填入实际密码后再启动 docker-compose
#
#   cp .env.example .env
#
# 安全要求：所有密码必须至少 8 位，包含大小写字母和数字
# ============================================================

# ---- JWT (生产环境必须替换为强随机密钥) ----
# 生成: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-256-bit-key
# access_token 有效期（毫秒，默认 30 分钟）/ refresh_token 有效期（毫秒，默认 7 天）
JWT_ACCESS_EXPIRE=1800000
JWT_REFRESH_EXPIRE=604800000

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- Redis ----
# 本地开发保持 localhost，Docker 部署在 docker-compose 中自动覆盖
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms
REDIS_PASSWORD=change-me-to-a-strong-password
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0
